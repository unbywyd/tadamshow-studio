      "maxLength": 40
    },
    "typed": {
      "type": "string",
      "maxLength": 40
    },
    "lang": {
      "type": "string",
      "enum": [
        "ru",
        "en"
      ]
    },
    "client": {
      "type": "string",
      "maxLength": 200
    },
    "keyName": {
      "type": "string",
