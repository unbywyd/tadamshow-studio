{
  "$id": "https://tadamshow.com/schemas/world.json",
  "title": "world",
  "description": "world.json: the card of a world and its bible",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 300
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "object",
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "en": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "ru"
      ]
    },
    "tagline": {
      "type": "object",
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "en": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "ru"
      ]
    },
    "description": {
      "type": "object",
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "en": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "ru"
      ]
    },
    "genre": {
      "type": "string",
      "maxLength": 80
    },
    "langs": {
      "default": [
        "ru"
      ],
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ru",
          "en"
        ]
      }
    },
    "cover": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}(?:\\/[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}){0,7}$"
    },
    "bible": {
      "type": "object",
      "properties": {
        "idea": {
          "type": "object",
          "properties": {
            "ru": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "en": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "ru"
          ]
        },
        "tone": {
          "type": "object",
          "properties": {
            "ru": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "en": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "ru"
          ]
        },
        "style": {
          "type": "object",
          "properties": {
            "ru": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "en": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "ru"
          ]
        },
        "rules": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "en": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "ru"
            ]
          }
        },
        "heroes": {
          "type": "object",
          "properties": {
            "ru": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "en": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "ru"
          ]
        }
      }
    }
  },
  "required": [
    "version",
    "slug",
    "title"
  ],
  "additionalProperties": false
}
