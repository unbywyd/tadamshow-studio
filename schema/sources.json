{
  "$id": "https://tadamshow.com/schemas/sources.json",
  "title": "sources",
  "description": "sources.json at the world root: where every picture and sound comes from",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 300
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 300,
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}(?:\\/[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}){0,7}\\/?$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "const": "own"
              },
              "author": {
                "type": "string",
                "maxLength": 200
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "const": "generated"
              },
              "tool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "source",
              "tool"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "const": "licensed"
              },
              "licence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "url": {
                "type": "string",
                "maxLength": 500,
                "format": "uri"
              },
              "author": {
                "type": "string",
                "maxLength": 200
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "source",
              "licence",
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "files"
  ],
  "additionalProperties": false
}
