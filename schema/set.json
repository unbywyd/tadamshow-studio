{
  "$id": "https://tadamshow.com/schemas/set.json",
  "title": "set",
  "description": "sets/<slug>/set.json: a room, far layers and furniture",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 300
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "background": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}\\/){0,2}[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}$"
    },
    "floor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ground": {
      "type": "object",
      "properties": {
        "far": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "far_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "tilt": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "far"
      ],
      "additionalProperties": {}
    },
    "backdrops": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "image": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}\\/){0,2}[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}$"
          },
          "scale": {
            "type": "number",
            "minimum": 0,
            "maximum": 4
          },
          "rect": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -2,
                "maximum": 3
              },
              {
                "type": "number",
                "minimum": -2,
                "maximum": 3
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "id",
          "image",
          "rect"
        ],
        "additionalProperties": {}
      }
    },
    "pieces": {
      "default": [],
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "image": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}\\/){0,2}[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}$"
          },
          "rect": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -2,
                "maximum": 3
              },
              {
                "type": "number",
                "minimum": -2,
                "maximum": 3
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "base": {
            "type": "number",
            "minimum": -1,
            "maximum": 2
          },
          "bias": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "front": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "image",
          "rect"
        ],
        "additionalProperties": {}
      }
    },
    "points": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "face": {
            "type": "string",
            "maxLength": 10
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "background",
    "floor",
    "ground"
  ],
  "additionalProperties": {}
}
