{
  "$id": "https://tadamshow.com/schemas/status.response.json",
  "title": "status.response",
  "description": "GET /api/studio/status",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "worlds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "en": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "ru"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "soon",
              "live",
              "hidden",
              "archived"
            ]
          },
          "rev": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "lastPush": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rev": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "at": {
                    "type": "string"
                  },
                  "by": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "ok": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "required": [
                  "rev",
                  "at",
                  "by",
                  "ok"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "episodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "title": {
                  "type": "object",
                  "properties": {
                    "ru": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "en": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "ru"
                  ],
                  "additionalProperties": false
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "idea",
                    "script",
                    "recording",
                    "rendering",
                    "review",
                    "scheduled",
                    "published",
                    "archived"
                  ]
                },
                "draft": {
                  "type": "boolean"
                },
                "submission": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "publish",
                            "revision",
                            "unpublish"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "pending",
                            "approved",
                            "changes",
                            "rejected",
                            "withdrawn"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "kind",
                        "status"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "missing": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "message": {
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "code",
                      "message"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "number",
                "title",
                "status",
                "draft",
                "submission",
                "missing"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "rev",
          "lastPush",
          "episodes"
        ],
        "additionalProperties": false
      }
    },
    "submissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": [
              "publish",
              "revision",
              "unpublish"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "changes",
              "rejected",
              "withdrawn"
            ]
          },
          "world": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "episode": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "world",
          "episode",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "unread": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "worlds",
    "submissions",
    "unread",
    "notifications"
  ],
  "additionalProperties": false
}
