              }
            },
            "required": [
              "character"
            ]
          }
        },
        "narrator": {
          "type": "object",
          "properties": {
            "engine": {
              "default": "silero",
              "type": "string",
              "enum": [
                "silero",
                "piper"
              ]
            },
            "voice": {
              "default": "eduard",
