{
  "$id": "https://tadamshow.com/schemas/push-begin.response.json",
  "title": "push-begin.response",
  "description": "answer of push/begin",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pushId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "uploads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}(?:\\/[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}){0,7}$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "headers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "url",
          "headers",
          "expiresAt"
        ],
        "additionalProperties": false
      }
    },
    "kept": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "string"
    }
  },
  "required": [
    "pushId",
    "rev",
    "uploads",
    "kept",
    "expiresAt"
  ],
  "additionalProperties": false
}
