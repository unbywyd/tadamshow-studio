{
  "$id": "https://tadamshow.com/schemas/bad-words.json",
  "description": "the studio word check: lowercase, ё→е, words = runs of [a-zа-я0-9], a word matches when the whole word matches a pattern; {P} = an optional Russian prefix (prefixes.ru)",
  "version": 1,
  "prefixes": {
    "ru": [
      "а",
      "в",
      "вз",
      "вы",
      "до",
      "за",
      "из",
      "на",
      "не",
      "недо",
      "о",
      "об",
      "от",
      "по",
      "под",
      "пере",
      "при",
      "про",
      "раз",
      "рас",
      "с",
      "у",
      "въ",
      "взъ",
      "изъ",
      "объ",
      "отъ",
      "подъ",
      "разъ",
      "съ"
    ]
  },
  "rules": [
    {
      "level": "error",
      "topic": "swearing",
      "lang": "ru",
      "patterns": [
        "{P}ху[йеияю][а-я]*",
        "{P}п[иеё]зд[а-я]*",
        "{P}еб(?:а|у|ал|ан|ат|ет|ен|ну|ыр|ло|ли|ля|ош|ись|ит|ич)[а-я]*",
        "долбо[её]б[а-я]*",
        "бля(?:д[а-я]*|ть|ха|хи)?",
        "сук(?:а|и|е|у|ой|ами|ах|ин[а-я]*)",
        "муд(?:ак|ил|озвон|ачь|охать)[а-я]*",
        "гандон[а-я]*",
        "гондон[а-я]*",
        "залуп[а-я]*",
        "шлюх[а-я]*",
        "манд(?:а|у|ы|ой|ятина)"
      ]
    },
    {
      "level": "error",
      "topic": "slur",
      "lang": "ru",
      "patterns": [
