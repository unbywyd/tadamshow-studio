{
  "$id": "https://tadamshow.com/schemas/script.v1.json",
  "title": "script.v1",
  "description": "an episode script, version 1 (server paths; kept valid)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "cast": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,23}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "character": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "character"
        ]
      }
    },
    "narrator": {
      "type": "object",
      "properties": {
        "engine": {
          "default": "silero",
          "type": "string",
          "enum": [
            "silero",
            "piper"
          ]
        },
        "voice": {
          "default": "eduard",
          "type": "string",
          "maxLength": 40
        },
        "fx": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "radio"
          ]
        }
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,23}$"
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "info",
                "read",
                "wait_ok",
                "look",
                "pause"
              ]
            },
            "text": {
              "type": "object",
              "properties": {
                "ru": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "en": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "ru"
              ]
            },
            "hint": {
              "type": "object",
              "properties": {
                "ru": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "en": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "ru"
              ]
            },
            "look": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "string",
                    "enum": [
                      "lens",
                      "mark_left",
                      "mark_right",
                      "mark_up",
                      "mark_down",
                      "point"
                    ]
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "atSec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "holdSec": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "target"
                ]
              }
            },
            "phone": {
              "type": "string",
              "enum": [
                "eye",
                "low",
                "high"
              ]
            },
            "maxSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120
            },
            "phrases": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "required": [
            "key",
            "kind"
          ]
        }
      }
    },
    "shots": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,24}$"
          },
          "remark": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "en": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "ru"
            ]
          },
          "about": {
            "type": "string",
            "maxLength": 1500
          },
          "say": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "listen": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,23}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
            }
          },
          "narration": {
            "type": "object",
            "properties": {
              "text": {
                "type": "object",
                "properties": {
                  "ru": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 800
                  },
                  "en": {
                    "type": "string",
                    "maxLength": 800
                  }
                },
                "required": [
                  "ru"
                ]
              },
              "at": {
                "default": 0.5,
                "type": "number",
                "minimum": 0
              },
              "db": {
                "default": 0,
                "type": "number"
              }
            },
            "required": [
              "text"
            ]
          },
          "card": {
            "type": "object",
            "properties": {
              "title": {
                "type": "object",
                "properties": {
                  "ru": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "en": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": [
                  "ru"
                ]
              },
              "sub": {
                "type": "object",
                "properties": {
                  "ru": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "en": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": [
                  "ru"
                ]
              },
              "kicker": {
                "type": "object",
                "properties": {
                  "ru": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "en": {
                    "type": "string",
                    "maxLength": 80
                  }
                },
                "required": [
                  "ru"
                ]
              },
              "from": {
                "type": "number",
                "minimum": 0
              },
              "to": {
                "type": "number",
                "minimum": 0
              },
              "top": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "title"
            ]
          },
          "seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 120
          }
        },
        "required": [
          "id",
          "remark"
        ],
        "additionalProperties": {}
      }
    },
    "film": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "version",
    "cast",
    "roles",
    "shots",
    "film"
  ]
}
